<?xml version="1.0" encoding="utf-8"?>
<!-- kudcrafts: sign-in, like the web app's login: mascot, serif "Welcome back", one card, one pill button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kc_sidebar"
        android:fitsSystemWindows="true">

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="72dp"
                android:paddingBottom="32dp">

            <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_sms_gray_48dp"
                    android:importantForAccessibility="no"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/kc_login_dialog_title"
                    android:fontFamily="@font/instrument_serif"
                    app:fontFamily="@font/instrument_serif"
                    android:textAppearance="@style/TextAppearance.Kc.Display"/>
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/kc_login_dialog_description"
                    android:textAppearance="@style/TextAppearance.Kc.Body"
                    android:textSize="14.5sp"
                    android:textColor="@color/kc_ink_3"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/kc_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                <LinearLayout
                        android:id="@+id/kc_login_server_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                    <TextView
                            style="@style/Widget.Kc.FieldLabel"
                            android:text="@string/kc_login_dialog_server_hint"/>
                    <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/kc_login_server_layout"
                            style="@style/Widget.Kc.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:hintEnabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/kc_login_server"
                                style="@style/Widget.Kc.Field"
                                android:inputType="textUri"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                        style="@style/Widget.Kc.FieldLabel"
                        android:text="@string/kc_login_dialog_username_hint"/>
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/kc_login_username_layout"
                        style="@style/Widget.Kc.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/kc_login_username"
                            style="@style/Widget.Kc.Field"
                            android:autofillHints="username"
                            android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                        style="@style/Widget.Kc.FieldLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/kc_login_dialog_password_hint"/>
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/kc_login_password_layout"
                        style="@style/Widget.Kc.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/kc_ink_3">
                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/kc_login_password"
                            style="@style/Widget.Kc.Field"
                            android:autofillHints="password"
                            android:inputType="textPassword"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/kc_login_submit"
                        style="@style/Widget.Kc.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/kc_login_dialog_button_sign_in"/>
                <ProgressBar
                        android:id="@+id/kc_login_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/kc_accent"
                        android:visibility="gone"/>
            </LinearLayout>

            <TextView
                    android:id="@+id/kc_login_server_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:textAppearance="@style/TextAppearance.Kc.Small"
                    android:textColor="@color/kc_ink_3"/>
        </LinearLayout>
    </ScrollView>

    <ImageButton
            android:id="@+id/kc_login_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kc_login_dialog_button_cancel"
            android:src="@drawable/ic_close_kc"
            app:tint="@color/kc_ink_2"/>
</FrameLayout>
