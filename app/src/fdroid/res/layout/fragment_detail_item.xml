<?xml version="1.0" encoding="utf-8"?>
<!-- kudcrafts: message row in the web inbox's style: priority accent bar, round app icon, "App / Topic" + relative time,
     bold title with priority badge, 3-line body, tag chips, pill actions, hairline. Same view ids as upstream's
     fragment_detail_item.xml (which this replaces for the fdroid flavor); kc_* ids are bound in DetailAdapter. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/detail_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/kc_canvas"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardUseCompatPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detail_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="16dp">

        <View
                android:id="@+id/kc_detail_item_priority_bar"
                android:layout_width="3dp"
                android:layout_height="0dp"
                android:layout_marginStart="-20dp"
                android:background="@color/kc_urgent"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detail_item_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Kc.Circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:importantForAccessibility="no"/>

        <TextView
                android:id="@+id/kc_detail_item_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Kc.Small"
                android:textColor="@color/kc_ink_3"
                app:layout_constraintStart_toEndOf="@id/detail_item_icon"
                app:layout_constraintEnd_toStartOf="@id/detail_item_date_text"
                app:layout_constraintTop_toTopOf="parent"/>

        <TextView
                android:id="@+id/detail_item_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Kc.Small"
                android:textColor="@color/kc_ink_2"
                android:textFontWeight="500"
                android:fontFeatureSettings="tnum"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toStartOf="@id/detail_item_new_dot"
                app:layout_constraintBaseline_toBaselineOf="@id/kc_detail_item_source"/>
        <View
                android:id="@+id/detail_item_new_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/kc_unread_dot"
                app:layout_constraintEnd_toStartOf="@id/detail_item_menu_button"
                app:layout_constraintTop_toTopOf="@id/detail_item_date_text"
                app:layout_constraintBottom_toBottomOf="@id/detail_item_date_text"/>
        <ImageButton
                android:id="@+id/detail_item_menu_button"
                android:layout_width="28dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_more_horiz_gray_24dp"
                app:tint="@color/kc_ink_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/detail_item_date_text"
                app:layout_constraintBottom_toBottomOf="@id/detail_item_date_text"/>
        <!-- Upstream's priority arrows: replaced by the accent bar + badge, kept for the adapter -->
        <ImageView
                android:id="@+id/detail_item_priority_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:importantForAccessibility="no"/>

        <TextView
                android:id="@+id/detail_item_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Kc.Title"
                android:textColor="@color/kc_ink"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toStartOf="@id/kc_detail_item_badge"
                app:layout_constraintTop_toBottomOf="@id/kc_detail_item_source"/>
        <TextView
                android:id="@+id/kc_detail_item_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/kc_badge_urgent"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="2dp"
                android:textAppearance="@style/TextAppearance.Kc.Small"
                android:textSize="12sp"
                android:textColor="@color/kc_urgent"
                android:textFontWeight="500"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/detail_item_title_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/detail_item_title_text"
                app:layout_constraintBottom_toBottomOf="@id/detail_item_title_text"/>

        <TextView
                android:id="@+id/detail_item_message_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:lineSpacingMultiplier="1.12"
                android:textAppearance="@style/TextAppearance.Kc.Body"
                android:textSize="14.5sp"
                android:textColor="@color/kc_ink_2"
                android:autoLink="web"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_title_text"/>

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detail_item_attachment_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:adjustViewBounds="true"
                android:maxHeight="180dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Kc.Medium"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_message_text"/>

        <TextView
                android:id="@+id/detail_item_tags_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Kc.Small"
                android:textSize="12sp"
                android:textColor="@color/kc_ink_3"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_attachment_image"/>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/detail_item_attachment_file_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kc_box"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_tags_text">
            <ImageView
                    android:id="@+id/detail_item_attachment_file_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_cancel_gray_24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:importantForAccessibility="no"/>
            <TextView
                    android:id="@+id/detail_item_attachment_file_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textAppearance="@style/TextAppearance.Kc.Small"
                    android:textColor="@color/kc_ink_2"
                    app:layout_constraintStart_toEndOf="@id/detail_item_attachment_file_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/detail_item_actions_wrapper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_attachment_file_box">
            <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/detail_item_actions_flow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:flow_wrapMode="chain2"
                    app:flow_horizontalStyle="packed"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="8dp"
                    app:flow_verticalGap="8dp"
                    app:flow_firstHorizontalBias="0"
                    app:flow_firstHorizontalStyle="packed"
                    app:flow_verticalAlign="top"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
                android:id="@+id/detail_item_padding_bottom"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_actions_wrapper"/>
        <View
                android:id="@+id/kc_detail_item_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/kc_line"
                app:layout_constraintStart_toStartOf="@id/kc_detail_item_source"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detail_item_padding_bottom"
                app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
