<?xml version="1.0" encoding="utf-8"?>
<!-- kudcrafts: app header above a multi-topic app's topics, like the web sidebar's app row (fdroid look) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="2dp">
    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/main_app_header_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Kc.Circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:importantForAccessibility="no"/>
    <TextView
            android:id="@+id/main_app_header_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Kc.Title"
            android:textColor="@color/kc_ink"
            app:layout_constraintStart_toEndOf="@id/main_app_header_icon"
            app:layout_constraintEnd_toStartOf="@id/main_app_header_unread"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
            android:id="@+id/main_app_header_unread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:drawablePadding="6dp"
            android:textAppearance="@style/TextAppearance.Kc.Small"
            android:textColor="@color/kc_ink_2"
            android:textFontWeight="500"
            android:fontFeatureSettings="tnum"
            app:drawableStartCompat="@drawable/kc_unread_dot"
            app:layout_constraintEnd_toStartOf="@id/main_app_header_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageButton
            android:id="@+id/main_app_header_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/kc_main_app_header_menu"
            android:src="@drawable/ic_more_horiz_gray_24dp"
            app:tint="@color/kc_ink_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
