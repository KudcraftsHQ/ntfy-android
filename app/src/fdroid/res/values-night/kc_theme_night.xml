<?xml version="1.0" encoding="utf-8"?>
<!-- kudcrafts: upstream's values-night redefines these; repeat ours so the night qualifier does not bring the old ones back -->
<resources>
    <style name="ActionMode" parent="@style/Widget.AppCompat.ActionMode">
        <item name="background">@color/kc_canvas</item>
        <item name="titleTextStyle">@style/ActionModeTitle</item>
    </style>
    <style name="ActionModeTitle" parent="@style/TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/kc_ink</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
    </style>
    <style name="Theme.App.FullScreenDialog" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@color/kc_canvas</item>
        <item name="android:windowBackground">@color/kc_canvas</item>
        <item name="android:windowLightStatusBar">@bool/kc_light_bars</item>
        <item name="android:windowAnimationStyle">@style/Animation.App.FullScreenDialog</item>
    </style>
</resources>
